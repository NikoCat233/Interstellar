<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<SelfContained>false</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
		<PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="SIPSorcery" Version="8.0.23" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Interstellar.Messages\Message.cs" Link="Compatibility/Messages/Message.cs" />
		<Compile Include="..\Interstellar.Messages\MessageTag.cs" Link="Compatibility/Messages/MessageTag.cs" />
		<Compile Include="..\Interstellar.Messages\MessageProcessor.cs" Link="Compatibility/Messages/MessageProcessor.cs" />
		<Compile Include="..\Interstellar.Messages\MessagePacker.cs" Link="Compatibility/Messages/MessagePacker.cs" />
		<Compile Include="..\Interstellar.Messages\AudioHelpers.cs" Link="Compatibility/Messages/AudioHelpers.cs" />
		<Compile Include="..\Interstellar.Messages\GZipMessage.cs" Link="Compatibility/Messages/GZipMessage.cs" />
		<Compile Include="..\Interstellar.Messages\Variation\*.cs" Link="Compatibility/Messages/Variation/%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
