{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Fatal",
        "Microsoft.AspNetCore": "Fatal",
        "Microsoft.Hosting.Lifetime": "Fatal",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Server": {
    "Host": "localhost",
    "Port": 8000,
    "EnableSsl": false,
    "CertificatePath": "",
    "CertificateKeyPath": "",
    "MinTlsVersion": "1.0"
  },
  "Media": {
    "UdpPortRangeStart": 0,
    "UdpPortRangeEnd": 0
  },
  "AdminAuth": {
    "PasswordBcryptHash": "$2a$12$TK5l6xG2I5np5pSDRgOeGu72eIMWulfmiW5aOJkrS1jdKwNS1Stvm",
    "JwtKey": "ChangeThisJwtSigningKeyToAtLeast32Chars!",
    "JwtIssuer": "Interstellar.Server",
    "JwtAudience": "Interstellar.Admin",
    "JwtExpiresMinutes": 120
  }
}
